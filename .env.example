# Only the username of an already tested bot goes into the site's public build.
VITE_TELEGRAM_APPLICATION_BOT=

# Set these only in the bot process environment on the server.
TELEGRAM_APPLICATION_BOT_TOKEN=
TELEGRAM_APPLICATION_CHAT_ID=
# Optional topic ID inside a Telegram forum group.
TELEGRAM_APPLICATION_THREAD_ID=

# SHA-256 digest of the local ERP demo password.
ERP_DEMO_PASSWORD_SHA256=

# Optional local ERP sales test. Set the token only in the Vite process environment.
ERP_SALES_TELEGRAM_TOKEN=
ERP_SALES_TELEGRAM_CHAT_ID=
ERP_SALES_TELEGRAM_THREAD_ID=
